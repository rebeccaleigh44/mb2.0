---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Waves from '@/components/site/Waves.astro';
import Section from '@/components/site/Section.astro';
import SectionHeader from '@/components/site/SectionHeader.astro';
import Note from '@/components/site/Note.astro';
import Placeholder from '@/components/site/Placeholder.astro';
import Cta from '@/components/site/Cta.astro';
import { products } from '@/data/site';
import { details } from '@/data/productDetails';

export function getStaticPaths() {
	return products.map((p) => ({ params: { slug: p.slug } }));
}
const { slug } = Astro.params;
const p = products.find((x) => x.slug === slug)!;
const d = details[slug!];
const others = products.filter((x) => x.slug !== slug);
const anyConfirm = d.features.some((f) => f.confirm);
---
<BaseLayout title={p.name} pillar="product" description={d.lede}>
	<section class="page-hero noisy glow-paper fibers relative overflow-hidden py-[clamp(56px,8vw,120px)]">
		<Waves seed={12} opacity={0.8} />
		<div class="wrap">
			<p class="eyebrow mb-4"><a href="/product/" class="hover:underline">Product</a> · {p.name} · For {p.for.toLowerCase()}</p>
			<div class="grid gap-10 desk:grid-cols-[1fr_1fr] desk:items-end">
				<div>
					<h1 class="mb-6 max-w-[17ch]">{d.headlineBefore}<span class="em">{d.headlineEm}</span>{d.headlineAfter}</h1>
					<p class="lede max-w-[52ch]">{d.lede}</p>
					<div class="mt-8 flex flex-wrap gap-3">
						<a href={`/contact/?topic=${p.slug}`} class="btn max-pad:w-full">{d.cta}</a>
						<a href="#features" class="btn btn-outline max-pad:w-full">See features</a>
					</div>
				</div>
				<div class="border border-[var(--line-strong)] p-2">
					<div class="mb-2 flex gap-1.5" aria-hidden="true"><span class="size-2.5 rounded-full bg-[var(--line-strong)]"></span><span class="size-2.5 rounded-full bg-[var(--line-strong)]"></span><span class="size-2.5 rounded-full bg-[var(--line-strong)]"></span></div>
					<Placeholder label={`${p.name}: product screenshot`} ratio="16/10" />
				</div>
			</div>
		</div>
	</section>

	<Section tone="light">
		<div class="grid gap-8 desk:grid-cols-[1fr_1fr] desk:gap-16">
			<div><p class="eyebrow mb-3">The problem</p><h2 class="max-w-[20ch]">{d.problemTitle}</h2></div>
			<div class="grid gap-4">{d.problem.map((x) => <p class="lede">{x}</p>)}</div>
		</div>
	</Section>

	<Section id="features">
		<SectionHeader overline="Features" before="What " em={p.name} after=" does." />
		<div class="mt-12 grid gap-10 desk:grid-cols-2">
			{d.features.map((f, i) => (
				<div class="grid gap-4 pad:grid-cols-[.9fr_1.1fr] pad:items-center">
					<Placeholder label={`Screen: ${f.t}`} ratio="4/3" />
					<div><span class="font-mono text-[13px] text-[var(--red-ink)]">0{i + 1}</span><h3 class="mb-2 mt-1">{f.t}</h3><p class="body">{f.d}</p></div>
				</div>
			))}
		</div>
		{anyConfirm && <Note class="mt-8">Features are inferred from the one-line description. Please have the product owner confirm or replace them.</Note>}
	</Section>

	<Section tone="light">
		<SectionHeader overline="Who it’s for" before="Built for the people who " em="use" after=" it." />
		<div class="mt-12 grid gap-6 desk:grid-cols-3">
			{d.audience.map((a) => <div class="border border-[var(--line)] bg-[var(--card)] p-7"><h3 class="mb-3">{a.t}</h3><p class="body">{a.d}</p></div>)}
		</div>
	</Section>

	<Section>
		<div class="grid gap-8 desk:grid-cols-2 desk:gap-16">
			<div>
				<p class="eyebrow mb-3">Built the Mediabarn way</p>
				<h2 class="mb-4 max-w-[20ch]">Designed with the people who <span class="em">use</span> it.</h2>
				<p class="body max-w-[52ch]">{p.name} was built by the same team that runs our research lab and design studio. We test it with real users, and what we learn goes into the next release.</p>
			</div>
			{d.pricing ? (
				<div class="border border-[var(--line-strong)] p-8"><p class="eyebrow mb-2">Pricing</p><p class="h3 mb-4">{d.pricing}</p><a href={`/contact/?topic=${p.slug}`} class="btn max-pad:w-full">{d.cta}</a></div>
			) : (
				<div class="grid gap-px self-start border border-[var(--line)] bg-[var(--line)] pad:grid-cols-3">
					{[['Tested', 'with real users in our lab'], ['Supported', 'by the team that built it'], ['Improved', 'from what users tell us']].map(([t, s]) => <div class="bg-[var(--card)] p-5"><p class="h4">{t}</p><p class="body text-[14.5px]">{s}</p></div>)}
				</div>
			)}
		</div>
		{d.note && <Note class="mt-8">{d.note}</Note>}
	</Section>

	<Section tone="light">
		<p class="eyebrow mb-6">More from Mediabarn Product</p>
		<ul role="list" class="grid gap-4 desk:grid-cols-3">
			{others.map((o) => <li><a href={o.href} class="flex h-full flex-col gap-2 border border-[var(--line)] bg-[var(--card)] p-6 hover:border-[var(--red)]"><span class="eyebrow">{o.for}</span><span class="h3">{o.name} →</span><span class="body text-[15px]">{o.summary}</span></a></li>)}
		</ul>
	</Section>

	<Cta heading="See " em={p.name} after=" in action." body={`Tell us a little about your organization and we’ll walk you through ${p.name}.`} />
</BaseLayout>
