---
// Replaces the Creative Staffing link everywhere. This is the new Mediabarn Product "site".
import BaseLayout from '@/layouts/BaseLayout.astro';
import Waves from '@/components/site/Waves.astro';
import Section from '@/components/site/Section.astro';
import SectionHeader from '@/components/site/SectionHeader.astro';
import Note from '@/components/site/Note.astro';
import Placeholder from '@/components/site/Placeholder.astro';
import Cta from '@/components/site/Cta.astro';
import { products } from '@/data/site';
---
<BaseLayout title="Product" pillar="product" description="Software built and supported by Mediabarn: Chirp, Edjit, CXAlign, and Mediabarn Time.">
	<section class="page-hero noisy glow-paper fibers relative overflow-hidden py-[clamp(56px,8vw,120px)]">
		<Waves seed={11} opacity={0.8} />
		<div class="wrap">
			<p class="eyebrow mb-4">Product · Software we build and support</p>
			<h1 class="mb-6 max-w-[18ch]">Software shaped by <span class="em">research</span>.</h1>
			<p class="lede max-w-[60ch]">We kept seeing the same problems across clients and industries. For a few of them, the best answer was a product. Each one is designed and tested with the people who use it, by the same team that runs our research lab and design studio.</p>
			<nav aria-label="Find your product" class="mt-10">
				<p class="h4 mb-3">I’m looking for a tool for…</p>
				<ul role="list" class="flex flex-wrap gap-2">
					{products.map((p) => <li><a href={`#${p.slug}`} class="btn btn-outline !py-2 text-[14px]">{p.for.toLowerCase()}</a></li>)}
				</ul>
			</nav>
		</div>
	</section>

	{products.map((p, i) => (
		<section id={p.slug} class:list={['border-t border-[var(--line)] py-[clamp(48px,6vw,88px)]', i % 2 === 1 && 'bg-[var(--paper-light)]']}>
			<div class="wrap grid gap-10 desk:grid-cols-2 desk:items-center">
				<div class:list={[i % 2 === 1 && 'desk:order-2']}>
					<p class="eyebrow mb-3">For {p.for.toLowerCase()}</p>
					<h2 class="mb-4">{p.name}</h2>
					<p class="lede mb-8 max-w-[48ch]">{p.summary}</p>
					<div class="flex flex-wrap gap-3"><a href={p.href} class="btn max-pad:w-full">Explore {p.name}</a><a href={`/contact/?topic=${p.slug}`} class="btn btn-outline max-pad:w-full">Request a demo</a></div>
				</div>
				<Placeholder label={`${p.name}: product screenshot`} ratio="16/10" />
			</div>
		</section>
	))}

	<Section tone="dark">
		<div class="grid gap-8 desk:grid-cols-[1.2fr_.8fr] desk:items-end">
			<div>
				<p class="eyebrow mb-3">Need something custom?</p>
				<h2 class="mb-4 max-w-[22ch]">If none of these fit, our design studio can build what <span class="em">does</span>.</h2>
				<p class="body max-w-[56ch]">We’ll start with research, design around what we learn, and recommend the right tools, whether we make them or not.</p>
			</div>
			<a href="/design/" class="btn btn-light justify-self-start max-pad:w-full desk:justify-self-end">Visit the design studio</a>
		</div>
	</Section>
	<div class="wrap"><Note class="my-6">Each product gets its own section with a direct link (good for ads and sales emails: /product/#chirp). If any product has its own domain or login, add a “Sign in” link to its section and page.</Note></div>
	<Cta />
</BaseLayout>
