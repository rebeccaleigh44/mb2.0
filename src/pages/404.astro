---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Waves from '@/components/site/Waves.astro';
import { pillars } from '@/data/site';
---
<BaseLayout title="Page not found">
	<section class="page-hero noisy glow-paper fibers relative overflow-hidden py-[clamp(56px,8vw,120px)]">
		<Waves seed={10} opacity={0.8} /><div class="wrap">
		<p class="eyebrow mb-4">Error 404</p>
		<h1 class="mb-6">This page isn’t <span class="em">here</span>.</h1>
		<p class="lede mb-8">Try one of our three pillars, or head back home.</p>
		<div class="flex flex-wrap gap-3">{pillars.map((p) => <a href={p.href} class="btn btn-outline">{p.name}</a>)}<a href="/" class="btn">Home</a></div>
	</div></section>
</BaseLayout>
