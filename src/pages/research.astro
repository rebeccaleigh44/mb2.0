---
// Content from mediabarnresearch.com, updated and restructured. That site becomes this page.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Waves from '@/components/site/Waves.astro';
import Section from '@/components/site/Section.astro';
import SectionHeader from '@/components/site/SectionHeader.astro';
import Note from '@/components/site/Note.astro';
import Placeholder from '@/components/site/Placeholder.astro';
import Cta from '@/components/site/Cta.astro';

const services = [
	{ t: 'Usability testing', d: 'We watch real people use your product in real time to see whether they can reach their goal, and where they get stuck.' },
	{ t: 'Mobile testing', d: 'Testing for mobile sites and iPhone, iPad, and Android apps. Every swipe and tap is captured in detail, along with the participant’s reactions, just like on desktop.' },
	{ t: 'Participant recruiting', d: 'Good participants make or break a study. Because we moderate studies ourselves, we look for people who are fresh and engaged, not serial respondents.' },
	{ t: 'Focus groups', d: 'A full-service focus group room with a large two-way mirror, next door to our usability lab.' },
	{ t: 'Remote user testing', d: 'Remote sessions, online focus groups, or our portable lab let you reach customers wherever they are, without the cost of travel.' },
	{ t: 'Moderation', d: 'Experienced moderators who keep sessions on track and participants at ease, so you get honest answers.' },
	{ t: 'Expert reviews', d: 'When time is short, our experts review your site or product against established usability principles. It’s not a replacement for testing, but it will tell you if you’re on track.' },
	{ t: 'Stakeholder interviews', d: 'Before a launch or redesign, we interview the people inside your organization to clarify goals and the strategic and practical implications of the work.' },
	{ t: 'Eye tracking', d: 'See exactly where participants look, and what they miss, on a page or screen.' },
];
const steps = [
	{ t: 'Plan', d: 'We agree on what you need to learn, who you need to hear from, and how we’ll measure it.' },
	{ t: 'Recruit', d: 'Our recruiting team screens and schedules participants who match your criteria.' },
	{ t: 'Run', d: 'Sessions run in our lab or remotely, moderated by us or by your team, with observers behind the glass or online.' },
	{ t: 'Report', d: 'You get findings and recommendations you can act on, and if you want, our design team can act on them with you.' },
];
const quotes = [
	{ q: 'I can honestly say you all have been the 100% best of all the markets in this study. Absolutely no issues, so professional, great respondents, cool facility, & fun to work with on top of all that.', who: 'Lead Researcher' },
	{ q: 'We had an excellent day. The participants were all of very high quality and your hospitality was second to none!', who: 'Researcher, Government Contractor' },
	{ q: 'You and your staff did an outstanding job and your facility is top notch! Our focus groups went off without a hitch and you were very attentive to our needs.', who: 'Lead Project Manager, Research Firm' },
];
---

<BaseLayout title="Research" pillar="research" description="Usability testing, participant recruiting, focus groups, and research lab facilities in Arlington, Virginia.">
	<section class="page-hero noisy glow-paper fibers relative overflow-hidden py-[clamp(56px,8vw,120px)]">
		<Waves seed={2} opacity={0.8} />
		<div class="wrap grid gap-10 desk:grid-cols-[1.1fr_.9fr] desk:items-end">
			<div>
				<h1 class="mb-6 max-w-[15ch]">User testing makes things <span class="em">better</span>.</h1>
				<p class="lede max-w-[54ch]">Better products, better websites, better customer experiences. We offer a full range of research and usability services, plus state-of-the-art lab and focus group facilities in Arlington, Virginia.</p>
				<div class="mt-8 flex flex-wrap gap-3"><a href="/contact/?topic=lab" class="btn max-pad:w-full">Book the lab</a><a href="#facility" class="btn btn-outline max-pad:w-full">Take a tour</a></div>
			</div>
			<Placeholder label="Lab photo: observation room through the glass" ratio="4/3" />
		</div>
	</section>

	<Section tone="light">
		<SectionHeader before="Full service, or just the " em="space" after="." />
		<div class="mt-12 grid gap-6 desk:grid-cols-2">
			<div class="flex flex-col gap-4 border border-[var(--line-strong)] bg-[var(--card)] p-8">
				<h3>Full-service research</h3>
				<p class="body">We plan the study, recruit participants, moderate the sessions, and report what we found.</p>
				<ul role="list" class="grid gap-1.5 body"><li>– Study design and screeners</li><li>– Recruiting and incentives</li><li>– Moderation and analysis</li><li>– Findings and recommendations</li></ul>
				<a href="/contact/?topic=research" class="btn mt-auto self-start max-pad:w-full">Plan a study</a>
			</div>
			<div class="flex flex-col gap-4 border border-[var(--line)] bg-[var(--card)] p-8">
				<h3>Facility rental</h3>
				<p class="body">Your team runs the sessions. We provide the lab, the focus group room, recruiting if you need it, and the hospitality.</p>
				<ul role="list" class="grid gap-1.5 body"><li>– Usability lab and focus group room</li><li>– Observation behind a two-way mirror</li><li>– Recording and streaming <span class="tbd">[confirm]</span></li><li>– Recruiting, as an add-on</li></ul>
				<a href="/contact/?topic=lab" class="btn btn-outline mt-auto self-start max-pad:w-full">Check availability</a>
			</div>
		</div>
		<Note class="mt-6">New section. The old site mixed these two audiences (researchers renting space, and clients who want us to do the research). Splitting them up front lets each find their path in one click.</Note>
	</Section>

	<Section id="services">
		<SectionHeader before="Research " em="services" after=".">A selection of what we offer. There are plenty more, and yes, we serve delicious cookies.</SectionHeader>
		<div class="mt-12 grid gap-px border border-[var(--line)] bg-[var(--line)] tab:grid-cols-2 desk:grid-cols-3">
			{services.map((s) => <div class="bg-[var(--card)] p-7"><h3 class="mb-3">{s.t}</h3><p class="body">{s.d}</p></div>)}
		</div>
		<Note class="mt-6">Eye tracking and moderation only appeared as keywords on the current site, so their descriptions are new. Please confirm eye tracking is still offered.</Note>
	</Section>

	<Section tone="light" id="facility">
		<SectionHeader before="A lab built for " em="watching" after=" people work.">Our Arlington suite has a dedicated usability lab and a full-service focus group facility with a large two-way mirror, a short walk from the Clarendon Metro.</SectionHeader>
		<div class="mt-12 grid gap-3 tab:grid-cols-4 tab:grid-rows-2">
			<Placeholder label="Usability lab" ratio="4/3" class="tab:col-span-2 tab:row-span-2 tab:!aspect-auto tab:h-full" />
			<Placeholder label="Focus group room" ratio="4/3" />
			<Placeholder label="Observation room" ratio="4/3" />
			<Placeholder label="Client lounge" ratio="4/3" />
			<Placeholder label="Mobile testing setup" ratio="4/3" />
		</div>
		<dl class="mt-10 grid gap-px border border-[var(--line)] bg-[var(--line)] tab:grid-cols-2 desk:grid-cols-4">
			{[
				{ t: 'Focus group room', d: 'Seats [00] participants, [00] observers' },
				{ t: 'Usability lab', d: '[Desktop, mobile, eye tracking]' },
				{ t: 'Location', d: '2200 Clarendon Blvd., #1401, Arlington, VA 22201' },
				{ t: 'Also available', d: 'A second lab in Virginia Beach, and a portable lab' },
			].map((x) => <div class="bg-[var(--card)] p-5"><dt class="eyebrow mb-1">{x.t}</dt><dd class="font-semibold">{x.d}</dd></div>)}
		</dl>
		<Note class="mt-6">“Take a Tour” on the old site was a button with no details. We need room capacities, equipment, and photos. A short video walkthrough would replace the photo grid well. The Clarendon Metro line is my assumption from the address.</Note>
	</Section>

	<Section>
		<SectionHeader before="From question to " em="answer" after=", in four steps." />
		<ol role="list" class="mt-12 grid gap-px border border-[var(--line)] bg-[var(--line)] tab:grid-cols-2 desk:grid-cols-4">
			{steps.map((s, i) => <li class="bg-[var(--card)] p-7"><span class="font-mono text-[13px] text-[var(--red-ink)]">0{i + 1}</span><h3 class="mb-2 mt-2">{s.t}</h3><p class="body">{s.d}</p></li>)}
		</ol>
	</Section>

	<Section tone="light">
		<SectionHeader before="Researchers keep coming " em="back" after="." />
		<div class="mt-12 grid gap-6 desk:grid-cols-3">
			{quotes.map((q) => (
				<figure class="flex flex-col gap-4 border border-[var(--line)] bg-[var(--card)] p-7">
					<blockquote class="grow text-[17px] leading-[1.55]">“{q.q}”</blockquote>
					<figcaption class="eyebrow">{q.who}</figcaption>
				</figure>
			))}
		</div>
		<Note class="mt-6">Quotes are trimmed from the current site, not reworded. If we can get names and companies with permission, they’ll carry more weight.</Note>
	</Section>

	<Cta heading="Ready to put your product in front of " em="real" after=" people?" body="Tell us what you need to learn, or when you need the lab. We’ll set up a time to talk it through." />
</BaseLayout>
