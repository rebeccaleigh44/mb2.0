---
// Square cursor: over any element with data-cursor="white|brown|red", the system cursor is replaced by a small
// shadowed square in that color. Mouse and trackpad only; touch, keyboard and no-JS keep the normal behaviour.
// Jiggling the mouse hard (fast back-and-forth) throws off red, brown and white confetti dots, unless reduced motion is on.
---
<div class="sq-cursor" aria-hidden="true"></div>
<script is:inline>
	(() => {
		if (!matchMedia('(hover: hover) and (pointer: fine)').matches) return;
		const sq = document.querySelector('.sq-cursor');
		if (!sq) return;
		document.documentElement.classList.add('sq-cursor-on');
		const calm = matchMedia('(prefers-reduced-motion: reduce)');
		const colors = ['var(--red)', 'var(--cocoa)', '#FFFFFF'];

		// Jiggle detection: count sharp, fast reversals of horizontal or vertical direction in the last 450ms
		let last = null, dirX = 0, dirY = 0, flips = [], live = 0, lastBurst = 0;
		const jiggle = (e) => {
			const now = performance.now();
			if (last) {
				const dx = e.clientX - last.x, dy = e.clientY - last.y, dt = Math.max(now - last.t, 1);
				const fast = Math.hypot(dx, dy) / dt > 1.2;
				const sx = Math.sign(dx), sy = Math.sign(dy);
				if (fast && ((sx && dirX && sx !== dirX) || (sy && dirY && sy !== dirY))) flips.push(now);
				if (sx) dirX = sx;
				if (sy) dirY = sy;
			}
			last = { x: e.clientX, y: e.clientY, t: now };
			flips = flips.filter((t) => now - t < 450);
			if (flips.length >= 3 && now - lastBurst > 40) { lastBurst = now; burst(e.clientX, e.clientY); }
		};
		const burst = (x, y) => {
			for (let n = 0; n < 4 && live < 90; n++) {
				const dot = document.createElement('span');
				const size = 4 + Math.random() * 4, angle = Math.random() * Math.PI * 2, dist = 30 + Math.random() * 70;
				dot.className = 'confetti';
				dot.style.cssText = `left:${x}px;top:${y}px;width:${size}px;height:${size}px;background:${colors[(Math.random() * 3) | 0]}`;
				document.body.append(dot);
				live++;
				dot.animate([
					{ transform: 'translate(-50%, -50%) scale(1)', opacity: 1 },
					{ transform: `translate(calc(-50% + ${Math.cos(angle) * dist}px), calc(-50% + ${Math.sin(angle) * dist + 40}px)) scale(.3)`, opacity: 0 },
				], { duration: 600 + Math.random() * 500, easing: 'cubic-bezier(.2,.7,.3,1)' }).onfinish = () => { dot.remove(); live--; };
			}
		};

		addEventListener('pointermove', (e) => {
			if (e.pointerType !== 'mouse') return;
			sq.style.setProperty('--x', `${e.clientX}px`);
			sq.style.setProperty('--y', `${e.clientY}px`);
			const t = e.target instanceof Element ? e.target.closest('[data-cursor]') : null;
			if (t) sq.dataset.color = t.dataset.cursor;
			sq.classList.toggle('on', !!t);
			if (!calm.matches) jiggle(e);
		}, { passive: true });
		document.addEventListener('pointerleave', () => { sq.classList.remove('on'); last = null; });
	})();
</script>
