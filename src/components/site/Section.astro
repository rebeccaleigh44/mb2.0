---
// Section: a drafting rule across the top with crosshairs where it meets the page gutters,
// and a tone. Content fades up on scroll.
interface Props {
	id?: string;
	tone?: 'paper' | 'light' | 'dark' | 'rust';
	/** noisy gradient behind the section (dark/rust/paper) */
	glow?: 'ember' | 'dusk' | 'clay' | 'paper';
	class?: string;
	reveal?: boolean;
}
const { id, tone = 'paper', glow, class: cls, reveal = true } = Astro.props;
---
<section id={id} class:list={[
	'rule noisy relative py-[clamp(64px,8vw,128px)]',
	{ 'bg-[var(--paper-light)]': tone === 'light', dark: tone === 'dark', rust: tone === 'rust', fibers: tone === 'paper' || tone === 'light' },
	glow && `glow-${glow}`,
	cls,
]}>
	<div class="pointer-events-none absolute inset-0 hidden pad:block" aria-hidden="true"><div class="wrap h-full"><div class="h-full border-x border-[var(--line)]"></div></div></div>
	<div class="wrap relative">
		<span class="cross hidden pad:block" style="top:calc(-1 * clamp(64px,8vw,128px) - 7px);left:calc(var(--gut) - 7px)" aria-hidden="true"></span>
		<span class="cross hidden pad:block" style="top:calc(-1 * clamp(64px,8vw,128px) - 7px);right:calc(var(--gut) - 7px)" aria-hidden="true"></span>
		<div data-reveal={reveal || undefined}><slot /></div>
	</div>
</section>
