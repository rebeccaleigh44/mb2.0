---
// Closing CTA, from the current site's "How can we help": warm, short, one aside.
import Waves from './Waves.astro';
interface Props { heading?: string; em?: string; after?: string; body?: string }
const {
	heading = 'How can we ',
	em = 'help',
	after = '?',
	body = 'Always up for a challenge, we take pride in the work we do and in the results we achieve for our clients. Tell us what you’re working on and we’ll point you to the right team: research, design, product, or all three.',
} = Astro.props;
---
<section class="rust noisy glow-clay relative overflow-hidden py-[clamp(72px,9vw,140px)]">
	<Waves seed={3} opacity={0.9} />
	<div class="wrap relative grid gap-10 desk:grid-cols-[1.3fr_1fr] desk:items-end">
		<div>
			<h2 class="max-w-[16ch] !text-[clamp(40px,6vw,88px)]">{heading}<span class="em">{em}</span>{after}</h2>
		</div>
		<div class="desk:border-l desk:border-[var(--line)] desk:pl-10">
			<p class="mb-8 text-[17px] leading-[1.65] text-[var(--fg-muted)]">{body}</p>
			<div class="flex flex-wrap gap-3">
				<a href="/contact/" class="btn btn-light max-pad:w-full">Get in touch <span class="arrow" aria-hidden="true">→</span></a>
				<a href="mailto:contactus@mediabarninc.com" class="btn btn-outline max-pad:w-full">contactus@mediabarninc.com</a>
			</div>
		</div>
	</div>
</section>
