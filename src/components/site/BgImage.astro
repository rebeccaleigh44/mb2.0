---
// Full-bleed background image for a section or card: fills its positioned parent, with a scrim so text stays
// readable. Without `src` it shows the noisy placeholder field with a drafting label. Given `slides`, it
// crossfades through them (first one only with reduced motion or no JS).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Slide { src: ImageMetadata; focus?: string }
interface Props {
	label: string;
	src?: ImageMetadata;
	/** several photos to cycle through, in order; replaces `src` and `focus` */
	slides?: Slide[];
	/** scrim: light keeps ink text readable, dark/rust keep paper text readable */
	scrim?: 'light' | 'dark' | 'rust';
	mood?: 'ember' | 'dusk' | 'clay' | 'sand';
	/** CSS object-position, to keep the subject in frame */
	focus?: string;
	/** on wide screens, keep the photo to the right part of the section and fade it into the page, clear of the text */
	side?: boolean;
	/** where the placeholder label sits, so it doesn't collide with content */
	labelAt?: 'br' | 'tr';
	class?: string;
}
const { label, src, scrim = 'dark', mood = 'dusk', focus, side = false, labelAt = 'br', class: cls } = Astro.props;
const slides: Slide[] = Astro.props.slides ?? (src ? [{ src, focus }] : []);
const moods = {
	ember: 'radial-gradient(70% 80% at 70% 25%, var(--clay), transparent 70%), radial-gradient(60% 70% at 85% 85%, var(--red), transparent 70%), var(--cocoa)',
	dusk: 'radial-gradient(80% 70% at 70% 100%, var(--rust), transparent 70%), radial-gradient(60% 60% at 80% 10%, var(--sand), transparent 70%), var(--espresso)',
	clay: 'radial-gradient(90% 80% at 70% 30%, var(--clay), transparent 75%), radial-gradient(60% 60% at 10% 90%, var(--cocoa), transparent 70%), var(--rust)',
	sand: 'radial-gradient(70% 80% at 75% 45%, var(--cocoa), transparent 65%), radial-gradient(90% 90% at 60% 50%, var(--sand), transparent 90%), var(--paper-deep)',
};
// Small sources stretched full-bleed get a touch of blur so they read as atmosphere rather than as a blurry photo.
// Side mode only fills about half the width, so it tolerates smaller sources.
const soft = (s: ImageMetadata) => s.width < (side ? 600 : 900);
const cycling = slides.length > 1;
---
<div class:list={['bg-image', `scrim-${scrim}`, side && 'bg-side', cycling && 'bg-cycle', cls]} aria-hidden="true" style={slides.length ? undefined : `--ph:${moods[mood]}`}>
	{slides.length
		? slides.map((s, i) => <Image src={s.src} alt="" widths={[640, 1024, 1600, 2400].filter((w) => w < s.src.width).concat(s.src.width)} sizes={side ? '(min-width: 1021px) 58vw, 100vw' : '100vw'} loading={i === 0 ? 'eager' : 'lazy'} class:list={[soft(s.src) && 'soft', cycling && 'slide', i === 0 && cycling && 'on']} style={s.focus ? `object-position:${s.focus}` : undefined} />)
		: <span class:list={['bg-image-label', labelAt === 'tr' && 'at-tr']}>Background photo: {label}</span>}
</div>
{cycling && (
	<script is:inline>
		(() => {
			if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
			document.querySelectorAll('.bg-cycle:not([data-cycling])').forEach((el) => {
				el.dataset.cycling = '';
				const imgs = [...el.querySelectorAll('img.slide')];
				imgs.forEach((img) => { img.loading = 'eager'; });
				let i = 0;
				setInterval(() => {
					if (document.hidden) return;
					imgs[i].classList.remove('on');
					i = (i + 1) % imgs.length;
					imgs[i].classList.add('on');
				}, 6500);
			});
		})();
	</script>
)}
