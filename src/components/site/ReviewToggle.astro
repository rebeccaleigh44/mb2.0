---
// Floating "Review notes" switch for the review period. Remove before launch.
---
<button type="button" id="notes-toggle" aria-pressed="false" class="fixed bottom-4 left-4 z-50 flex items-center gap-2 border border-[var(--line-strong)] bg-[var(--paper-light)] px-3 py-2 font-semibold text-[11.5px] uppercase tracking-[0.12em] text-[var(--ink)] shadow-[0_6px_20px_-8px_rgba(30,18,14,.35)] hover:border-[var(--ink)]">
	<span class="size-2 rounded-full bg-[var(--line-strong)]" aria-hidden="true"></span><span>Review notes</span>
</button>
<script is:inline>
	(() => {
		const b = document.getElementById('notes-toggle');
		const r = document.documentElement;
		const dot = b.firstElementChild;
		const sync = () => { const on = r.classList.contains('show-notes'); b.setAttribute('aria-pressed', String(on)); dot.style.background = on ? 'var(--red)' : ''; };
		try { if (localStorage.getItem('mb-notes') === 'on' || location.search.includes('notes')) r.classList.add('show-notes'); } catch {}
		sync();
		b.addEventListener('click', () => { r.classList.toggle('show-notes'); try { localStorage.setItem('mb-notes', r.classList.contains('show-notes') ? 'on' : 'off'); } catch {} sync(); });
	})();
</script>
