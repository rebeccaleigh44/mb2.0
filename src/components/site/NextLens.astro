---
// End of every pillar page: the pillars before and after this one in the loop, with the handoff
// sentence that explains why they connect.
import { pillars, type PillarId } from '@/data/site';
import Section from './Section.astro';
interface Props { current: PillarId }
const { current } = Astro.props;
const i = pillars.findIndex((p) => p.id === current);
const here = pillars[i];
const next = pillars[(i + 1) % 3];
const prev = pillars[(i + 2) % 3];
const links = [
	{ p: prev, n: (i + 2) % 3, rel: 'Before this', line: prev.handoff },
	{ p: next, n: (i + 1) % 3, rel: 'After this', line: here.handoff },
];
---
<Section tone="dark" glow="ember" label={`The loop / 0${i + 1} of 03`}>
	<h2 class="mb-12 max-w-[20ch]">{here.name} is one part of the <span class="em">loop</span>.</h2>
	<div class="grid gap-px border border-[var(--line)] bg-[var(--line)] tab:grid-cols-2">
		{links.map(({ p, n, rel, line }) => (
			<a href={p.href} class="group flex flex-col gap-4 bg-[var(--espresso)] p-8 transition-colors hover:bg-[var(--cocoa)]">
				<span class="eyebrow">{rel} / 0{n + 1}</span>
				<span class="font-serif text-[clamp(30px,3vw,40px)] leading-none text-[var(--paper-light)]">{p.name}<span class="text-[var(--red-glow)]">.</span> <span class="arrow text-[0.7em] text-[var(--red-glow)]" aria-hidden="true">→</span></span>
				<span class="body">{line}</span>
			</a>
		))}
	</div>
</Section>
